<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup rules for Android 12 (API 31) and higher.
    See https://developer.android.com/about/versions/12/backup-restore#xml-changes

    Only the player's own data is kept: the settings and the word statistics. A game in
    progress is left out. It makes no sense to resume it days later or on another phone,
    and its word pack might not exist in the app version installed there.
    Keep these rules in sync with backup_rules.xml (Android 11 and lower).
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/settings.preferences_pb" />
        <include domain="file" path="datastore/word_stats.preferences_pb" />
        <!-- The app language on Android 12 and lower, stored by AppCompat (autoStoreLocales). -->
        <include domain="file" path="androidx.appcompat.app.AppCompatDelegate.application_locales_record_file" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/settings.preferences_pb" />
        <include domain="file" path="datastore/word_stats.preferences_pb" />
        <!-- The app language on Android 12 and lower, stored by AppCompat (autoStoreLocales). -->
        <include domain="file" path="androidx.appcompat.app.AppCompatDelegate.application_locales_record_file" />
    </device-transfer>
</data-extraction-rules>
