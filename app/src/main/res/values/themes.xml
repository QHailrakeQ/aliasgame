<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Style for the Splash Screen -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#6200EE</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.AliasGame
        </item>
    </style>
    <style name="Theme.AliasGame" parent="Theme.AppCompat.DayNight.NoActionBar">

        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryDark">@color/purple_700</item>
        <item name="colorAccent">@color/teal_200</item>


        <item name="android:statusBarColor">@color/purple_700</item>
    </style>
</resources>
